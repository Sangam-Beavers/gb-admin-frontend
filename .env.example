# ─────────────────────────────────────────────────────────────
# 백엔드 admin-service API 호출
# 프론트는 same-origin으로 /api/v1/admin/... 호출 → Vite proxy가 admin-service(8085)로 reverse proxy.
# ─────────────────────────────────────────────────────────────
# VITE_API_BASE_URL=

# 인증 우회 (오늘 데모용). PKCE 정상 동작 확인 후 false 로 토글.
VITE_SKIP_AUTH=true

# ─────────────────────────────────────────────────────────────
# OIDC PKCE (개발기 Authentik)
# 실제 값은 .env.local / .env.development 에서 override.
# 운영 전환 시 Authentik 에 admin Application + admin group 정책을 별도로 등록한다.
# ─────────────────────────────────────────────────────────────
VITE_OIDC_CLIENT_ID=zT2Nkwd4Ui4hC26BYmsD6GywxmsTscruqtswkzq1
VITE_OIDC_AUTHORIZE_ENDPOINT=https://sso.sb.fisa/application/o/authorize/
VITE_OIDC_TOKEN_ENDPOINT=https://sso.sb.fisa/application/o/token/
VITE_OIDC_REDIRECT_URI=http://localhost:5174/auth/callback
VITE_OIDC_SCOPE=openid profile email gb-public-id

VITE_OIDC_END_SESSION_ENDPOINT=
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5174/login

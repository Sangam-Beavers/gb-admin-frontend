// ─────────────────────────────────────────────────────────────
// gb-admin-frontend (monitoring) CI/CD 파이프라인 (stage)
//
// Stage 1) Checkout (SCM)
// Stage 2) SonarQube 분석: TypeScript 정적 분석
// Stage 3) 품질 게이트: 통과 못 하면 빌드 중단
// Stage 4) amd64 이미지 빌드 & push (kaniko — Dockerfile 내부에서 pnpm build)
// Stage 5) arm64 이미지 빌드 & push (kaniko)
// Stage 6) 멀티아키 manifest 합치기 (regctl)
// Stage 7) GitOps: gb-infra charts/monitoring/values-stage.yaml image tag 갱신 → ArgoCD 감지
//
// 인증 없는 관리자 모니터링 대시보드 (ProtectedRoute 무조건 pass-through).
// OIDC/Cognito 환경변수 불필요. ADMIN_API_URL은 values-stage.yaml에서 ConfigMap으로 주입.
// ─────────────────────────────────────────────────────────────
pipeline {
  agent {
    kubernetes {
      yaml '''
        spec:
          containers:
          - name: scanner
            image: sonarsource/sonar-scanner-cli:latest
            command: ["sleep"]
            args: ["infinity"]
            securityContext:
              runAsUser: 0
            resources:
              requests:
                memory: "512Mi"
                cpu: "200m"
              limits:
                memory: "1Gi"
          - name: kaniko-amd64
            image: gcr.io/kaniko-project/executor:debug
            command: ["sleep"]
            args: ["infinity"]
            resources:
              requests:
                memory: "1Gi"
                cpu: "500m"
              limits:
                memory: "2Gi"
            volumeMounts:
            - name: harbor-dockercfg
              mountPath: /kaniko/.docker
          - name: kaniko-arm64
            image: gcr.io/kaniko-project/executor:debug
            command: ["sleep"]
            args: ["infinity"]
            resources:
              requests:
                memory: "1Gi"
                cpu: "500m"
              limits:
                memory: "2Gi"
            volumeMounts:
            - name: harbor-dockercfg
              mountPath: /kaniko/.docker
          - name: regctl
            image: ghcr.io/regclient/regctl:alpine
            command: ["sleep"]
            args: ["infinity"]
            volumeMounts:
            - name: harbor-dockercfg
              mountPath: /home/appuser/.docker
          - name: git
            image: alpine/git:latest
            command: ["sleep"]
            args: ["infinity"]
          volumes:
          - name: harbor-dockercfg
            secret:
              secretName: harbor-dockercfg
              items:
              - key: .dockerconfigjson
                path: config.json
      '''
    }
  }

  environment {
    REGISTRY     = "harbor.sb.fisa"
    IMAGE_BASE   = "${REGISTRY}/global_bridge/monitoring"
    IMAGE_TAG    = "${BUILD_NUMBER}"
    CONFIG_REPO  = "github.com/Sangam-Beavers/gb-infra"
    VALUES_PATH  = "charts/monitoring/values-stage.yaml"
    INFRA_BRANCH = "main"
  }

  stages {
    stage('1) Checkout') {
      steps {
        checkout scm
      }
    }

    stage('2) SonarQube 분석') {
      steps {
        container('scanner') {
          withSonarQubeEnv('sonarqube') {
            sh '''
              sonar-scanner \
                -Dsonar.projectKey=gb-monitoring-frontend-stage \
                -Dsonar.sources=src \
                -Dsonar.inclusions=**/*.ts,**/*.tsx \
                -Dsonar.exclusions=node_modules/**,dist/**,src/mocks/**
            '''
          }
        }
      }
    }

    stage('3) 품질 게이트') {
      steps {
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: false
        }
      }
    }

    stage('4) amd64 이미지 빌드 & push') {
      steps {
        container('kaniko-amd64') {
          sh '''
            /kaniko/executor \
              --context `pwd` \
              --dockerfile Dockerfile \
              --destination ${IMAGE_BASE}:${IMAGE_TAG}-amd64 \
              --custom-platform=linux/amd64 \
              --snapshot-mode=redo \
              --skip-tls-verify
          '''
        }
      }
    }

    stage('5) arm64 이미지 빌드 & push') {
      steps {
        container('kaniko-arm64') {
          sh '''
            /kaniko/executor \
              --context `pwd` \
              --dockerfile Dockerfile \
              --destination ${IMAGE_BASE}:${IMAGE_TAG}-arm64 \
              --custom-platform=linux/arm64 \
              --snapshot-mode=redo \
              --skip-tls-verify
          '''
        }
      }
    }

    stage('6) 멀티아키 manifest 합치기') {
      steps {
        container('regctl') {
          sh '''
            regctl --host "reg=harbor.sb.fisa,tls=insecure" index create ${IMAGE_BASE}:${IMAGE_TAG} \
              --ref ${IMAGE_BASE}:${IMAGE_TAG}-amd64 \
              --ref ${IMAGE_BASE}:${IMAGE_TAG}-arm64
          '''
        }
      }
    }

    stage('7) Config repo 업데이트 (GitOps)') {
      steps {
        container('git') {
          withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
            sh '''
              set -e
              git config --global user.name  "Jenkins CI"
              git config --global user.email "jenkins@sb.fisa"
              git clone --branch ${INFRA_BRANCH} https://oauth2:${GITHUB_TOKEN}@${CONFIG_REPO}.git config-repo
              cd config-repo
              sed -i 's|^\\(  tag:\\).*|\\1 "'"${IMAGE_TAG}"'"|' ${VALUES_PATH}
              echo "=== 변경된 내용 ==="
              grep "tag:" ${VALUES_PATH}
              if git diff --quiet; then
                echo "변경사항 없음 — 커밋 생략"
                exit 0
              fi
              git add ${VALUES_PATH}
              git commit -m "ci: bump monitoring image to ${IMAGE_TAG} (stage, multi-arch)"
              git push origin ${INFRA_BRANCH}
            '''
          }
        }
      }
    }
  }

  post {
    success { echo "✅ 멀티아키 이미지 ${IMAGE_BASE}:${IMAGE_TAG} → gb-infra ${INFRA_BRANCH} 커밋 → ArgoCD stage 배포" }
    failure { echo "❌ 실패 — 어느 stage에서 멈췄는지 확인하세요." }
  }
}
